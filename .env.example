# TrendHits Server Configuration
PORT=3000

# Brevo (Sendinblue) Integration
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_LIST_ID=2
BREVO_SENDER_NAME=TrendHits Music Intelligence
BREVO_SENDER_EMAIL=newsletter@trendhits.com

# AI Integration (Optional - Falls back to live verified corpus if omitted)
# Get your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Automated Cron Scheduler (Optional)
CRON_ENABLED=false
CRON_SCHEDULE=0 0 * * *
